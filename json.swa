// json.swa -- maktaba ya JSON kwa lugha ya Swa (kuchanganua + kuandika)
//
// Bila libc. Inatumia tu maktaba ya msingi ya Swa: kumbukumbu.swa
// (tenga, nakili) na mfuatano.swa (urefu_wa_mfuatano, mfuatano_umbiza).
//
// Uwakilishi wa thamani: muundo MMOJA (Json) wenye uwanja wa "aina"
// (tag) -- Swa haina union wala enum, kwa hiyo aina sita za JSON
// (null, bool, nambari, mfuatano, orodha, kitu) zinatofautishwa kwa
// uwanja wa `aina`, na kila aina hutumia sehemu yake ya nyanja tu.
// Majina yote ya kazi/aina/vigezo vya ulimwengu yanaanza na `json_`
// au `Json` kwa sababu Swa haina nafasi za majina (namespace).
//
// Kumbukumbu: inatengwa kwa arena ya kumbukumbu.swa, ambayo haifungui
// vipande vya kibinafsi (achilia_arena ni no-op kwa makusudi) --
// kumbukumbu inarudishwa programu inapoisha.

husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }

// ==========================================================
// 1. Uwakilishi wa thamani
// ==========================================================

// Aina za thamani (thamani za uwanja `aina`).
n32 JSON_NULL = 0;
n32 JSON_BOOL = 1;
n32 JSON_NAMBARI = 2;
n32 JSON_MFUATANO = 3;
n32 JSON_ORODHA = 4;
n32 JSON_KITU = 5;

// Kina cha juu kabisa cha nesting (orodha/vitu ndani ya orodha/vitu)
// kinachokubaliwa na kichanganuzi -- kinalinda rafu ya wito.
n32 JSON_KINA_JUU = 512;

// Nyanja zinazotumika kwa kila aina:
//   JSON_NULL      -- hakuna
//   JSON_BOOL      -- kweli (0 au 1)
//   JSON_NAMBARI   -- nambari (thamani ya D64) na maandishi (maandishi
//                     asili kama yalivyoandikwa kwenye JSON, au 0 kama
//                     nambari imejengwa kwa programu)
//   JSON_MFUATANO  -- maandishi (baiti za UTF-8, zinaishia kwa NUL)
//   JSON_ORODHA    -- vipengele[0..idadi-1]
//   JSON_KITU      -- funguo[i] na vipengele[i] (jozi sambamba, kwa
//                     mpangilio wa kuingizwa)
// Muundo wa Swa umepakiwa bila nafasi za ulinganifu (packed).
muundo Json {
    n32 aina;
    n32 kweli;
    d64 nambari;
    n8* maandishi;
    Json** vipengele;
    n8** funguo;
    n32 idadi;
    n32 uwezo;
};

// Tengeneza thamani tupu ya aina fulani. Inarudisha 0 kama kumbukumbu
// imeisha.
Json* json_mpya(n32 aina) {
    Json* v = tenga(ukubwa(Json));
    kama (v == 0) { rudisha 0; }
    v->aina = aina;
    v->kweli = 0;
    v->nambari = 0.0;
    v->maandishi = 0;
    v->vipengele = 0;
    v->funguo = 0;
    v->idadi = 0;
    v->uwezo = 0;
    rudisha v;
}

// Nakili baiti `n` za `chanzo` kwenye mfuatano mpya unaoishia kwa NUL.
n8* json_nakili_n(n8* chanzo, n32 n) {
    n8* r = tenga(n + 1);
    kama (r == 0) { rudisha 0; }
    nakili(r, chanzo, n);
    r[n] = 0;
    rudisha r;
}

Json* json_null() {
    rudisha json_mpya(JSON_NULL);
}

Json* json_bool(n32 kweli) {
    Json* v = json_mpya(JSON_BOOL);
    kama (v == 0) { rudisha 0; }
    v->kweli = 0;
    kama (kweli != 0) { v->kweli = 1; }
    rudisha v;
}

// Nambari iliyojengwa kwa programu (haina maandishi asili).
Json* json_nambari(d64 x) {
    Json* v = json_mpya(JSON_NAMBARI);
    kama (v == 0) { rudisha 0; }
    v->nambari = x;
    rudisha v;
}

// Mfuatano (unanakiliwa -- `s` inaweza kubadilishwa baadaye).
Json* json_mfuatano(n8* s) {
    Json* v = json_mpya(JSON_MFUATANO);
    kama (v == 0) { rudisha 0; }
    v->maandishi = json_nakili_n(s, urefu_wa_mfuatano(s));
    kama (v->maandishi == 0) { rudisha 0; }
    rudisha v;
}

Json* json_orodha() {
    rudisha json_mpya(JSON_ORODHA);
}

Json* json_kitu() {
    rudisha json_mpya(JSON_KITU);
}

// Hakikisha kuna nafasi ya angalau kipengele kimoja zaidi. Inakua
// mara mbili (kuanzia 4). Inarudisha 1 kwa mafanikio, 0 kama
// kumbukumbu imeisha. Tunanakili baiti `idadi*8` tu kwa nakili()
// (badala ya badili() ya maktaba, ambayo inasoma baiti 8 zaidi ya
// kipande cha zamani).
n32 json_kua(Json* v) {
    kama (v->idadi < v->uwezo) { rudisha 1; }
    n32 mpya = v->uwezo * 2;
    kama (mpya < 4) { mpya = 4; }
    n64 baiti = ukubwa(n64) * mpya;
    n64 zamani = ukubwa(n64) * v->idadi;
    n8* vp = tenga(baiti);
    kama (vp == 0) { rudisha 0; }
    kama (v->idadi > 0) { nakili(vp, v->vipengele, zamani); }
    kama (v->aina == JSON_KITU) {
        n8* fp = tenga(baiti);
        kama (fp == 0) { rudisha 0; }
        kama (v->idadi > 0) { nakili(fp, v->funguo, zamani); }
        v->funguo = fp;
    }
    v->vipengele = vp;
    v->uwezo = mpya;
    rudisha 1;
}

// Ongeza kipengele mwishoni mwa orodha. Inarudisha 1/0.
n32 json_orodha_ongeza(Json* orodha, Json* kipengele) {
    kama (orodha == 0 || kipengele == 0) { rudisha 0; }
    kama (orodha->aina != JSON_ORODHA) { rudisha 0; }
    kama (json_kua(orodha) == 0) { rudisha 0; }
    orodha->vipengele[orodha->idadi] = kipengele;
    orodha->idadi = orodha->idadi + 1;
    rudisha 1;
}

// Tafuta nafasi ya ufunguo kwenye kitu; -1 kama haupo.
n32 json_nafasi_ya_ufunguo(Json* kitu, n8* ufunguo) {
    n32 i = 0;
    wakati (i < kitu->idadi) {
        kama (linganisha_mfuatano(kitu->funguo[i], ufunguo) == 0) { rudisha i; }
        i = i + 1;
    }
    rudisha -1;
}

// Weka `kipengele` chini ya `ufunguo`. Ufunguo ukiwepo tayari, thamani
// yake inabadilishwa mahali pale pale (mpangilio wa ufunguo wa
// kwanza unabaki -- sawa na dict ya Python: ufunguo unaorudiwa,
// thamani ya MWISHO ndiyo inashinda). Ufunguo unanakiliwa.
// Inarudisha 1/0.
n32 json_kitu_weka(Json* kitu, n8* ufunguo, Json* kipengele) {
    kama (kitu == 0 || kipengele == 0) { rudisha 0; }
    kama (kitu->aina != JSON_KITU) { rudisha 0; }
    n32 nafasi = json_nafasi_ya_ufunguo(kitu, ufunguo);
    kama (nafasi >= 0) {
        kitu->vipengele[nafasi] = kipengele;
        rudisha 1;
    }
    kama (json_kua(kitu) == 0) { rudisha 0; }
    n8* nakala = json_nakili_n(ufunguo, urefu_wa_mfuatano(ufunguo));
    kama (nakala == 0) { rudisha 0; }
    kitu->funguo[kitu->idadi] = nakala;
    kitu->vipengele[kitu->idadi] = kipengele;
    kitu->idadi = kitu->idadi + 1;
    rudisha 1;
}

// ---- Vifikiaji (accessors) ----

n32 json_aina(Json* v) { rudisha v->aina; }

// Idadi ya vipengele (orodha/kitu) au urefu wa baiti (mfuatano);
// 0 kwa aina nyingine.
n32 json_urefu(Json* v) {
    kama (v->aina == JSON_ORODHA || v->aina == JSON_KITU) { rudisha v->idadi; }
    kama (v->aina == JSON_MFUATANO) { rudisha urefu_wa_mfuatano(v->maandishi); }
    rudisha 0;
}

// Kipengele cha orodha kwa faharisi; 0 kama nje ya mipaka au si orodha.
Json* json_kipengele(Json* orodha, n32 faharisi) {
    kama (orodha->aina != JSON_ORODHA) { rudisha 0; }
    kama (faharisi < 0 || faharisi >= orodha->idadi) { rudisha 0; }
    rudisha orodha->vipengele[faharisi];
}

// Thamani ya kitu kwa ufunguo; 0 kama haipo au si kitu.
Json* json_pata(Json* kitu, n8* ufunguo) {
    kama (kitu->aina != JSON_KITU) { rudisha 0; }
    n32 nafasi = json_nafasi_ya_ufunguo(kitu, ufunguo);
    kama (nafasi < 0) { rudisha 0; }
    rudisha kitu->vipengele[nafasi];
}

// Ufunguo wa kitu kwa faharisi; 0 kama nje ya mipaka au si kitu.
n8* json_ufunguo_wa(Json* kitu, n32 faharisi) {
    kama (kitu->aina != JSON_KITU) { rudisha 0; }
    kama (faharisi < 0 || faharisi >= kitu->idadi) { rudisha 0; }
    rudisha kitu->funguo[faharisi];
}

// Thamani ya bool (0/1); 0 kwa aina isiyo bool.
n32 json_thamani_bool(Json* v) {
    kama (v->aina != JSON_BOOL) { rudisha 0; }
    rudisha v->kweli;
}

// Thamani ya nambari; 0.0 kwa aina isiyo nambari.
d64 json_thamani_nambari(Json* v) {
    kama (v->aina != JSON_NAMBARI) { rudisha 0.0; }
    rudisha v->nambari;
}

// Thamani ya mfuatano; 0 kwa aina isiyo mfuatano.
n8* json_thamani_mfuatano(Json* v) {
    kama (v->aina != JSON_MFUATANO) { rudisha 0; }
    rudisha v->maandishi;
}

// ==========================================================
// 2. Kichanganuzi (parser) -- recursive descent, sarufi kamili ya JSON
// ==========================================================
//
// Inakubali JSON kamili ya RFC 8259 kwa vikwazo vilivyoorodheshwa
// kwenye README (hakuna \u0000, hakuna surrogate isiyo na jozi,
// hakuna uthibitisho wa UTF-8 -- baiti za >= 0x80 zinapita kama zilivyo).
// Kila kosa linaripoti nafasi, mstari na safu.

muundo JsonKosa {
    n32 msimbo;    // 0 = hakuna kosa, 1 = kuna kosa
    n32 nafasi;    // nafasi ya baiti (kuanzia 0)
    n32 mstari;    // mstari (kuanzia 1)
    n32 safu;      // safu kwa baiti (kuanzia 1)
    n8* ujumbe;    // maelezo ya kosa
};

muundo JsonKichanganuzi {
    n8* chanzo;
    n32 urefu;
    n32 nafasi;
    n32 kina;
    JsonKosa* kosa;
};

// Andika kosa la kwanza tu (makosa yanayofuata yanapuuzwa) pamoja na
// mstari/safu ya nafasi ya sasa. Mtumiaji anarudisha 0 mwenyewe.
w0 json_kosa(JsonKichanganuzi* p, n8* ujumbe) {
    JsonKosa* k = p->kosa;
    kama (k->msimbo != 0) { rudisha; }
    k->msimbo = 1;
    k->nafasi = p->nafasi;
    k->ujumbe = ujumbe;
    n32 mstari = 1;
    n32 safu = 1;
    n32 i = 0;
    wakati (i < p->nafasi && i < p->urefu) {
        kama (p->chanzo[i] == 10) {
            mstari = mstari + 1;
            safu = 1;
        } sivyo {
            safu = safu + 1;
        }
        i = i + 1;
    }
    k->mstari = mstari;
    k->safu = safu;
}

// Baiti kwenye nafasi `i` kama nambari 0..255 (N8 ya Swa ina ishara:
// baiti >= 0x80 ingesomwa kama hasi); -1 ikiwa nje ya chanzo.
n32 json_bayti_kwa(JsonKichanganuzi* p, n32 i) {
    kama (i < 0 || i >= p->urefu) { rudisha -1; }
    n32 c = p->chanzo[i];
    kama (c < 0) { c = c + 256; }
    rudisha c;
}

// Baiti ya sasa (au -1 mwishoni mwa chanzo).
n32 json_sasa(JsonKichanganuzi* p) {
    rudisha json_bayti_kwa(p, p->nafasi);
}

w0 json_songa(JsonKichanganuzi* p) {
    p->nafasi = p->nafasi + 1;
}

// Ruka nafasi tupu za JSON: space, tab, LF, CR.
w0 json_ruka_nafasi(JsonKichanganuzi* p) {
    wakati (1 == 1) {
        n32 c = json_sasa(p);
        kama (c == 32 || c == 9 || c == 10 || c == 13) {
            p->nafasi = p->nafasi + 1;
        } sivyo {
            vunja;
        }
    }
}

// Linganisha neno la ASCII (true/false/null) kwenye nafasi ya sasa;
// ikilingana, songa mbele na rudisha 1.
n32 json_neno(JsonKichanganuzi* p, n8* neno) {
    n32 n = urefu_wa_mfuatano(neno);
    kama (p->nafasi + n > p->urefu) { rudisha 0; }
    n32 i = 0;
    wakati (i < n) {
        kama (p->chanzo[p->nafasi + i] != neno[i]) { rudisha 0; }
        i = i + 1;
    }
    p->nafasi = p->nafasi + n;
    rudisha 1;
}

// Thamani ya tarakimu ya heksadesimali, au -1.
n32 json_hex(n32 c) {
    kama (c >= 48 && c <= 57) { rudisha c - 48; }
    kama (c >= 97 && c <= 102) { rudisha c - 87; }
    kama (c >= 65 && c <= 70) { rudisha c - 55; }
    rudisha -1;
}

// Soma tarakimu 4 za heksadesimali kuanzia `kuanzia` (zote lazima ziwe
// kabla ya `kikomo`); rudisha thamani (0..65535) au -1.
n32 json_hex4(JsonKichanganuzi* p, n32 kuanzia, n32 kikomo) {
    kama (kuanzia + 4 > kikomo) { rudisha -1; }
    n32 thamani = 0;
    n32 i = 0;
    wakati (i < 4) {
        n32 h = json_hex(json_bayti_kwa(p, kuanzia + i));
        kama (h < 0) { rudisha -1; }
        thamani = thamani * 16 + h;
        i = i + 1;
    }
    rudisha thamani;
}

// Andika alama ya Unicode `cp` kama baiti za UTF-8 kwenye r[w..];
// rudisha nafasi mpya ya kuandika.
n32 json_weka_utf8(n8* r, n32 w, n32 cp) {
    kama (cp < 128) {
        r[w] = cp;
        rudisha w + 1;
    }
    kama (cp < 2048) {
        r[w] = 192 + (cp / 64);
        r[w + 1] = 128 + (cp % 64);
        rudisha w + 2;
    }
    kama (cp < 65536) {
        r[w] = 224 + (cp / 4096);
        r[w + 1] = 128 + ((cp / 64) % 64);
        r[w + 2] = 128 + (cp % 64);
        rudisha w + 3;
    }
    r[w] = 240 + (cp / 262144);
    r[w + 1] = 128 + ((cp / 4096) % 64);
    r[w + 2] = 128 + ((cp / 64) % 64);
    r[w + 3] = 128 + (cp % 64);
    rudisha w + 4;
}

// Changanua mfuatano wa JSON; nafasi ya sasa ni '"' ya kufungua.
// Inarudisha mfuatano uliosimbuliwa (unaoishia kwa NUL) au 0 kwa kosa.
n8* json_changanua_herufi(JsonKichanganuzi* p) {
    p->nafasi = p->nafasi + 1;
    n32 mwanzo = p->nafasi;

    // Pita ya 1: tafuta '"' ya kufunga; kataa herufi za udhibiti.
    n32 i = mwanzo;
    wakati (1 == 1) {
        kama (i >= p->urefu) {
            p->nafasi = p->urefu;
            json_kosa(p, "mfuatano haujafungwa (\" ya kufunga inakosekana)");
            rudisha 0;
        }
        n32 c = json_bayti_kwa(p, i);
        kama (c == 34) { vunja; }
        kama (c < 32) {
            p->nafasi = i;
            json_kosa(p, "herufi ya udhibiti (< 0x20) ndani ya mfuatano lazima iandikwe kwa \\u....");
            rudisha 0;
        }
        kama (c == 92) {
            i = i + 2;
        } sivyo {
            i = i + 1;
        }
    }
    n32 kiwango = i;

    // Pita ya 2: simbua. Urefu uliosimbuliwa ni <= urefu wa asili.
    n8* r = tenga(kiwango - mwanzo + 1);
    kama (r == 0) {
        json_kosa(p, "kumbukumbu imeisha");
        rudisha 0;
    }
    n32 w = 0;
    n32 j = mwanzo;
    wakati (j < kiwango) {
        n32 c = json_bayti_kwa(p, j);
        kama (c != 92) {
            r[w] = c;
            w = w + 1;
            j = j + 1;
            endelea;
        }
        j = j + 1;
        n32 e = json_bayti_kwa(p, j);
        kama (j >= kiwango) { e = -1; }
        kama (e == 34) { r[w] = 34; w = w + 1; j = j + 1; endelea; }
        kama (e == 92) { r[w] = 92; w = w + 1; j = j + 1; endelea; }
        kama (e == 47) { r[w] = 47; w = w + 1; j = j + 1; endelea; }
        kama (e == 98) { r[w] = 8; w = w + 1; j = j + 1; endelea; }
        kama (e == 102) { r[w] = 12; w = w + 1; j = j + 1; endelea; }
        kama (e == 110) { r[w] = 10; w = w + 1; j = j + 1; endelea; }
        kama (e == 114) { r[w] = 13; w = w + 1; j = j + 1; endelea; }
        kama (e == 116) { r[w] = 9; w = w + 1; j = j + 1; endelea; }
        kama (e != 117) {
            p->nafasi = j;
            json_kosa(p, "mfuatano wa kutoroka (escape) usio sahihi baada ya \\");
            rudisha 0;
        }
        // \uXXXX
        n32 cp = json_hex4(p, j + 1, kiwango);
        kama (cp < 0) {
            p->nafasi = j;
            json_kosa(p, "\\u lazima ifuatwe na tarakimu 4 za heksadesimali");
            rudisha 0;
        }
        j = j + 5;
        kama (cp >= 55296 && cp <= 56319) {
            // surrogate ya juu -- lazima ifuatwe na \uDC00..\uDFFF
            n32 chini = -1;
            kama (json_bayti_kwa(p, j) == 92 && json_bayti_kwa(p, j + 1) == 117) {
                chini = json_hex4(p, j + 2, kiwango);
            }
            kama (chini < 56320 || chini > 57343) {
                p->nafasi = j;
                json_kosa(p, "surrogate ya juu ya UTF-16 (\\uD800..\\uDBFF) haina jozi ya chini (\\uDC00..\\uDFFF)");
                rudisha 0;
            }
            cp = 65536 + ((cp - 55296) * 1024) + (chini - 56320);
            j = j + 6;
        } sivyo {
            kama (cp >= 56320 && cp <= 57343) {
                p->nafasi = j - 5;
                json_kosa(p, "surrogate ya chini ya UTF-16 (\\uDC00..\\uDFFF) haina jozi ya juu");
                rudisha 0;
            }
        }
        kama (cp == 0) {
            p->nafasi = j - 5;
            json_kosa(p, "\\u0000 haikubaliwi (mfuatano wa Swa unaishia kwa NUL)");
            rudisha 0;
        }
        w = json_weka_utf8(r, w, cp);
    }
    r[w] = 0;
    p->nafasi = kiwango + 1;
    rudisha r;
}

// 10^k kama D64 (k kati ya 0 na 400; zaidi ya 308 inakuwa isiyo na mwisho).
d64 json_p10(n32 k) {
    d64 p = 1.0;
    n32 i = 0;
    kama (k > 400) { k = 400; }
    wakati (i < k) {
        p = p * 10.0;
        i = i + 1;
    }
    rudisha p;
}

// Thamani ya D64 ya maandishi ya nambari ya JSON YALIYOTHIBITISHWA tayari
// kuwa sahihi. Mantissa inakusanywa kwenye N64 (tarakimu 18 za maana),
// kisha inazidishwa/kugawanywa kwa 10^kipeo -- sahihi kabisa kwa nambari
// zenye hadi tarakimu 15 na kipeo cha desimali kati ya -22 na 22; kwa
// nyingine kuna tofauti ndogo ya mzunguko (maandishi asili yanabaki
// kwenye Json.maandishi na ndiyo yanayoandikwa tena).
d64 json_thamani_ya_nambari(n8* s) {
    n32 i = 0;
    n32 hasi = 0;
    kama (s[i] == 45) {
        hasi = 1;
        i = i + 1;
    }
    n64 mant = 0;
    n32 tarakimu = 0;
    n32 kipeo = 0;
    wakati (s[i] >= 48 && s[i] <= 57) {
        n32 d = s[i] - 48;
        kama (tarakimu < 18) {
            mant = mant * 10 + d;
            kama (mant > 0) { tarakimu = tarakimu + 1; }
        } sivyo {
            kipeo = kipeo + 1;
        }
        i = i + 1;
    }
    kama (s[i] == 46) {
        i = i + 1;
        wakati (s[i] >= 48 && s[i] <= 57) {
            n32 d = s[i] - 48;
            kama (tarakimu < 18) {
                mant = mant * 10 + d;
                kipeo = kipeo - 1;
                kama (mant > 0) { tarakimu = tarakimu + 1; }
            }
            i = i + 1;
        }
    }
    kama (s[i] == 101 || s[i] == 69) {
        i = i + 1;
        n32 ehasi = 0;
        kama (s[i] == 45) {
            ehasi = 1;
            i = i + 1;
        } sivyo {
            kama (s[i] == 43) { i = i + 1; }
        }
        n32 e = 0;
        wakati (s[i] >= 48 && s[i] <= 57) {
            kama (e < 100000) { e = e * 10 + (s[i] - 48); }
            i = i + 1;
        }
        kama (ehasi == 1) {
            kipeo = kipeo - e;
        } sivyo {
            kipeo = kipeo + e;
        }
    }
    kama (mant == 0) { rudisha 0.0; }
    d64 x = mant;
    // Kupima kwa hatua (10^200 kwa wakati mmoja) ili 10^k isizidi D64
    // wakati matokeo yenyewe bado yanawakilishika (mf. 2.2250738585072014e-308
    // ina kipeo -324).
    wakati (kipeo > 200) {
        x = x * json_p10(200);
        kipeo = kipeo - 200;
    }
    wakati (kipeo < -200) {
        x = x / json_p10(200);
        kipeo = kipeo + 200;
    }
    kama (kipeo > 0) {
        x = x * json_p10(kipeo);
    }
    kama (kipeo < 0) {
        x = x / json_p10(0 - kipeo);
    }
    kama (hasi == 1) { x = 0.0 - x; }
    rudisha x;
}

// Changanua nambari kwa sarufi kali: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
Json* json_changanua_nambari(JsonKichanganuzi* p) {
    n32 mwanzo = p->nafasi;
    n32 c = json_sasa(p);
    kama (c == 45) {
        p->nafasi = p->nafasi + 1;
        c = json_sasa(p);
    }
    kama (c == 48) {
        p->nafasi = p->nafasi + 1;
        c = json_sasa(p);
        kama (c >= 48 && c <= 57) {
            json_kosa(p, "sifuri ya mwanzo hairuhusiwi kwenye nambari");
            rudisha 0;
        }
    } sivyo {
        kama (c >= 49 && c <= 57) {
            wakati (c >= 48 && c <= 57) {
                p->nafasi = p->nafasi + 1;
                c = json_sasa(p);
            }
        } sivyo {
            json_kosa(p, "tarakimu inatarajiwa kwenye nambari");
            rudisha 0;
        }
    }
    kama (c == 46) {
        p->nafasi = p->nafasi + 1;
        c = json_sasa(p);
        kama (c < 48 || c > 57) {
            json_kosa(p, "tarakimu inatarajiwa baada ya nukta ya desimali");
            rudisha 0;
        }
        wakati (c >= 48 && c <= 57) {
            p->nafasi = p->nafasi + 1;
            c = json_sasa(p);
        }
    }
    kama (c == 101 || c == 69) {
        p->nafasi = p->nafasi + 1;
        c = json_sasa(p);
        kama (c == 43 || c == 45) {
            p->nafasi = p->nafasi + 1;
            c = json_sasa(p);
        }
        kama (c < 48 || c > 57) {
            json_kosa(p, "tarakimu inatarajiwa kwenye kipeo cha nambari");
            rudisha 0;
        }
        wakati (c >= 48 && c <= 57) {
            p->nafasi = p->nafasi + 1;
            c = json_sasa(p);
        }
    }
    Json* v = json_mpya(JSON_NAMBARI);
    kama (v == 0) {
        json_kosa(p, "kumbukumbu imeisha");
        rudisha 0;
    }
    v->maandishi = json_nakili_n(p->chanzo + mwanzo, p->nafasi - mwanzo);
    kama (v->maandishi == 0) {
        json_kosa(p, "kumbukumbu imeisha");
        rudisha 0;
    }
    v->nambari = json_thamani_ya_nambari(v->maandishi);
    rudisha v;
}

// Changanua orodha `[ ... ]`; nafasi ya sasa ni '['.
Json* json_changanua_orodha(JsonKichanganuzi* p) {
    p->nafasi = p->nafasi + 1;
    p->kina = p->kina + 1;
    kama (p->kina > JSON_KINA_JUU) {
        json_kosa(p, "kina cha nesting kimezidi kikomo (512)");
        rudisha 0;
    }
    Json* orodha = json_orodha();
    kama (orodha == 0) {
        json_kosa(p, "kumbukumbu imeisha");
        rudisha 0;
    }
    json_ruka_nafasi(p);
    kama (json_sasa(p) == 93) {
        p->nafasi = p->nafasi + 1;
        p->kina = p->kina - 1;
        rudisha orodha;
    }
    wakati (1 == 1) {
        Json* v = json_changanua_thamani(p);
        kama (v == 0) { rudisha 0; }
        kama (json_orodha_ongeza(orodha, v) == 0) {
            json_kosa(p, "kumbukumbu imeisha");
            rudisha 0;
        }
        json_ruka_nafasi(p);
        n32 c = json_sasa(p);
        kama (c == 44) {
            p->nafasi = p->nafasi + 1;
            endelea;
        }
        kama (c == 93) {
            p->nafasi = p->nafasi + 1;
            p->kina = p->kina - 1;
            rudisha orodha;
        }
        json_kosa(p, "',' au ']' inatarajiwa");
        rudisha 0;
    }
    rudisha orodha;
}

// Changanua kitu `{ "ufunguo": thamani, ... }`; nafasi ya sasa ni '{'.
Json* json_changanua_kitu(JsonKichanganuzi* p) {
    p->nafasi = p->nafasi + 1;
    p->kina = p->kina + 1;
    kama (p->kina > JSON_KINA_JUU) {
        json_kosa(p, "kina cha nesting kimezidi kikomo (512)");
        rudisha 0;
    }
    Json* kitu = json_kitu();
    kama (kitu == 0) {
        json_kosa(p, "kumbukumbu imeisha");
        rudisha 0;
    }
    json_ruka_nafasi(p);
    kama (json_sasa(p) == 125) {
        p->nafasi = p->nafasi + 1;
        p->kina = p->kina - 1;
        rudisha kitu;
    }
    wakati (1 == 1) {
        json_ruka_nafasi(p);
        kama (json_sasa(p) != 34) {
            json_kosa(p, "ufunguo (mfuatano kwenye nukuu) unatarajiwa");
            rudisha 0;
        }
        n8* ufunguo = json_changanua_herufi(p);
        kama (ufunguo == 0) { rudisha 0; }
        json_ruka_nafasi(p);
        kama (json_sasa(p) != 58) {
            json_kosa(p, "':' inatarajiwa baada ya ufunguo");
            rudisha 0;
        }
        p->nafasi = p->nafasi + 1;
        Json* v = json_changanua_thamani(p);
        kama (v == 0) { rudisha 0; }
        kama (json_kitu_weka(kitu, ufunguo, v) == 0) {
            json_kosa(p, "kumbukumbu imeisha");
            rudisha 0;
        }
        json_ruka_nafasi(p);
        n32 c = json_sasa(p);
        kama (c == 44) {
            p->nafasi = p->nafasi + 1;
            endelea;
        }
        kama (c == 125) {
            p->nafasi = p->nafasi + 1;
            p->kina = p->kina - 1;
            rudisha kitu;
        }
        json_kosa(p, "',' au '}' inatarajiwa");
        rudisha 0;
    }
    rudisha kitu;
}

// Changanua thamani yoyote kwenye nafasi ya sasa.
Json* json_changanua_thamani(JsonKichanganuzi* p) {
    json_ruka_nafasi(p);
    n32 c = json_sasa(p);
    kama (c < 0) {
        json_kosa(p, "mwisho wa maandishi usiotarajiwa: thamani inatarajiwa");
        rudisha 0;
    }
    kama (c == 123) { rudisha json_changanua_kitu(p); }
    kama (c == 91) { rudisha json_changanua_orodha(p); }
    kama (c == 34) {
        n8* s = json_changanua_herufi(p);
        kama (s == 0) { rudisha 0; }
        Json* v = json_mpya(JSON_MFUATANO);
        kama (v == 0) {
            json_kosa(p, "kumbukumbu imeisha");
            rudisha 0;
        }
        v->maandishi = s;
        rudisha v;
    }
    kama (c == 45 || (c >= 48 && c <= 57)) { rudisha json_changanua_nambari(p); }
    kama (c == 116) {
        kama (json_neno(p, "true")) { rudisha json_bool(1); }
    }
    kama (c == 102) {
        kama (json_neno(p, "false")) { rudisha json_bool(0); }
    }
    kama (c == 110) {
        kama (json_neno(p, "null")) { rudisha json_null(); }
    }
    json_kosa(p, "herufi isiyotarajiwa (thamani ya JSON inatarajiwa)");
    rudisha 0;
}

// Changanua maandishi ya JSON ya urefu `urefu` (baiti). Inarudisha
// thamani ya mzizi, au 0 kukiwa na kosa (na `kosa` inajazwa).
Json* json_changanua_n(n8* data, n32 urefu, JsonKosa* kosa) {
    kosa->msimbo = 0;
    kosa->nafasi = 0;
    kosa->mstari = 0;
    kosa->safu = 0;
    kosa->ujumbe = 0;
    JsonKichanganuzi* p = tenga(ukubwa(JsonKichanganuzi));
    kama (p == 0) {
        kosa->msimbo = 1;
        kosa->ujumbe = "kumbukumbu imeisha";
        rudisha 0;
    }
    p->chanzo = data;
    p->urefu = urefu;
    p->nafasi = 0;
    p->kina = 0;
    p->kosa = kosa;
    Json* v = json_changanua_thamani(p);
    kama (v == 0) { rudisha 0; }
    json_ruka_nafasi(p);
    kama (p->nafasi < p->urefu) {
        json_kosa(p, "maandishi ya ziada baada ya thamani ya JSON");
        rudisha 0;
    }
    rudisha v;
}

// Changanua mfuatano unaoishia kwa NUL.
Json* json_changanua(n8* maandishi, JsonKosa* kosa) {
    rudisha json_changanua_n(maandishi, urefu_wa_mfuatano(maandishi), kosa);
}

// Andika ujumbe wa kosa (pamoja na mstari/safu) kwenye `bafa`, kama
// "kosa la JSON: <maelezo> (mstari M, safu S, nafasi N)". Inarudisha
// idadi ya baiti zilizoandikwa (bila NUL). Tunatumia bafa_mfuatano /
// bafa_n64 za mfuatano.swa kwa sababu mfuatano_umbiza inapokea hoja
// zote kama N64 (kielekezi cha %s hakipitishwi moja kwa moja).
n64 json_ujumbe_wa_kosa(JsonKosa* kosa, n8* bafa, n64 uwezo) {
    kama (uwezo == 0) { rudisha 0; }
    n64 nafasi = 0;
    bafa_mfuatano(bafa, uwezo, &nafasi, "kosa la JSON: ");
    bafa_mfuatano(bafa, uwezo, &nafasi, kosa->ujumbe);
    bafa_mfuatano(bafa, uwezo, &nafasi, " (mstari ");
    bafa_n64(bafa, uwezo, &nafasi, kosa->mstari);
    bafa_mfuatano(bafa, uwezo, &nafasi, ", safu ");
    bafa_n64(bafa, uwezo, &nafasi, kosa->safu);
    bafa_mfuatano(bafa, uwezo, &nafasi, ", nafasi ");
    bafa_n64(bafa, uwezo, &nafasi, kosa->nafasi);
    bafa_mfuatano(bafa, uwezo, &nafasi, ")");
    bafa[nafasi] = 0;
    rudisha nafasi;
}

// ==========================================================
// 3. Kiandikaji (serializer)
// ==========================================================
//
// json_hadi_mfuatano: JSON ya mstari mmoja (compact).
// json_hadi_mfuatano_mzuri: yenye upangaji (indent) wa nafasi `ndani`
// kwa kila ngazi. Herufi za UTF-8 zinaandikwa kama zilivyo; herufi
// za udhibiti (< 0x20) zinatoroshwa. Nambari zilizochanganuliwa
// zinaandikwa kwa maandishi yake ASILI (hakuna upotevu wa usahihi);
// nambari zilizojengwa kwa programu zinapangwa kwa tarakimu 15 za maana.

muundo JsonBafa {
    n8* data;
    n32 idadi;
    n32 uwezo;
    n32 kosa;
};

JsonBafa* json_bafa_mpya() {
    JsonBafa* b = tenga(ukubwa(JsonBafa));
    kama (b == 0) { rudisha 0; }
    b->uwezo = 256;
    b->idadi = 0;
    b->kosa = 0;
    b->data = tenga(256);
    kama (b->data == 0) { rudisha 0; }
    rudisha b;
}

// Ongeza baiti moja. Daima kunabaki nafasi ya NUL ya mwisho.
w0 json_bafa_baiti(JsonBafa* b, n32 c) {
    kama (b->kosa != 0) { rudisha; }
    kama (b->idadi + 2 >= b->uwezo) {
        n32 mpya = b->uwezo * 2;
        n8* nd = tenga(mpya);
        kama (nd == 0) {
            b->kosa = 1;
            rudisha;
        }
        nakili(nd, b->data, b->idadi);
        b->data = nd;
        b->uwezo = mpya;
    }
    b->data[b->idadi] = c;
    b->idadi = b->idadi + 1;
}

w0 json_bafa_mfuatano(JsonBafa* b, n8* s) {
    n32 i = 0;
    wakati (s[i] != 0) {
        json_bafa_baiti(b, s[i]);
        i = i + 1;
    }
}

w0 json_bafa_nafasi(JsonBafa* b, n32 idadi) {
    n32 i = 0;
    wakati (i < idadi) {
        json_bafa_baiti(b, 32);
        i = i + 1;
    }
}

// Tarakimu ya heksadesimali ndogo (0..15 -> '0'..'9','a'..'f').
n32 json_herufi_hex(n32 h) {
    kama (h < 10) { rudisha 48 + h; }
    rudisha 87 + h;
}

// Andika mfuatano kwenye nukuu, ukitorosha inavyohitajika.
w0 json_andika_herufi(JsonBafa* b, n8* s) {
    json_bafa_baiti(b, 34);
    n32 i = 0;
    wakati (s[i] != 0) {
        n32 c = s[i];
        kama (c < 0) { c = c + 256; }
        kama (c == 34) {
            json_bafa_baiti(b, 92);
            json_bafa_baiti(b, 34);
        } sivyo {
            kama (c == 92) {
                json_bafa_baiti(b, 92);
                json_bafa_baiti(b, 92);
            } sivyo {
                kama (c == 8) {
                    json_bafa_baiti(b, 92);
                    json_bafa_baiti(b, 98);
                } sivyo {
                    kama (c == 12) {
                        json_bafa_baiti(b, 92);
                        json_bafa_baiti(b, 102);
                    } sivyo {
                        kama (c == 10) {
                            json_bafa_baiti(b, 92);
                            json_bafa_baiti(b, 110);
                        } sivyo {
                            kama (c == 13) {
                                json_bafa_baiti(b, 92);
                                json_bafa_baiti(b, 114);
                            } sivyo {
                                kama (c == 9) {
                                    json_bafa_baiti(b, 92);
                                    json_bafa_baiti(b, 116);
                                } sivyo {
                                    kama (c < 32) {
                                        json_bafa_baiti(b, 92);
                                        json_bafa_baiti(b, 117);
                                        json_bafa_baiti(b, 48);
                                        json_bafa_baiti(b, 48);
                                        json_bafa_baiti(b, json_herufi_hex(c / 16));
                                        json_bafa_baiti(b, json_herufi_hex(c % 16));
                                    } sivyo {
                                        json_bafa_baiti(b, c);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    json_bafa_baiti(b, 34);
}

// Panga nambari ya D64 (tarakimu 15 za maana, sawa na "%.15g"):
//  * kipeo cha desimali e kati ya -5 na 14 -> nukuu ya kawaida (0.00012, 123.5, 100000)
//  * vinginevyo -> nukuu ya kisayansi (1.5e+20, 1e-7), halali kwa JSON.
// Nambari isiyo na mwisho (na NaN) -> "null" (kama JSON.stringify ya
// JavaScript); thamani zote za mwisho hadi DBL_MAX zinaandikwa.
w0 json_andika_d64(JsonBafa* b, d64 x) {
    d64 a = x;
    kama (x < 0.0) { a = 0.0 - x; }
    kama (a == 0.0) {
        json_bafa_baiti(b, 48);
        rudisha;
    }
    // a*0.5 == a kwa nambari isiyo sifuri ni kweli TU kwa isiyo na mwisho
    // (na NaN) -- kipimo sahihi kabisa cha "finite" bila kikomo cha kubuni.
    kama (a * 0.5 == a) {
        json_bafa_mfuatano(b, "null");
        rudisha;
    }
    // Kipeo e: 10^e <= a < 10^(e+1) (makadirio; yanarekebishwa hapa chini).
    n32 e = 0;
    d64 p = 1.0;
    kama (a >= 1.0) {
        wakati (p * 10.0 <= a && e < 309) {
            p = p * 10.0;
            e = e + 1;
        }
    } sivyo {
        wakati (p > a && e > -330) {
            p = p / 10.0;
            e = e - 1;
        }
    }
    // Kokotoa m = a / 10^(e-14) kwa mzunguko -- lazima iwe kati ya 1e14
    // na 1e15 - 1; ikiwa sivyo, kipeo kilikadiriwa vibaya kwa 1, rekebisha.
    n64 m = 0;
    n32 jaribio = 0;
    wakati (jaribio < 4) {
        n32 k = 14 - e;
        d64 kipimo = a;
        kama (k > 200) {
            kipimo = kipimo * json_p10(200);
            k = k - 200;
        }
        kama (k >= 0) {
            kipimo = kipimo * json_p10(k);
        } sivyo {
            kipimo = kipimo / json_p10(0 - k);
        }
        m = kipimo + 0.5;
        kama (m >= 1000000000000000) {
            e = e + 1;
        } sivyo {
            kama (m < 100000000000000) {
                e = e - 1;
            } sivyo {
                vunja;
            }
        }
        jaribio = jaribio + 1;
    }
    kama (m < 100000000000000 || m >= 1000000000000000) {
        json_bafa_mfuatano(b, "null");
        rudisha;
    }
    kama (x < 0.0) { json_bafa_baiti(b, 45); }
    // Tarakimu 15 (kutoka muhimu zaidi), kisha ondoa sifuri za mwisho.
    n8 tar[16];
    n32 i = 14;
    n64 mm = m;
    wakati (i >= 0) {
        tar[i] = 48 + (mm % 10);
        mm = mm / 10;
        i = i - 1;
    }
    n32 nd = 15;
    wakati (nd > 1 && tar[nd - 1] == 48) { nd = nd - 1; }
    kama (e >= 0 && e < 15) {
        // Sehemu kamili ina tarakimu e+1.
        i = 0;
        wakati (i <= e) {
            kama (i < nd) {
                json_bafa_baiti(b, tar[i]);
            } sivyo {
                json_bafa_baiti(b, 48);
            }
            i = i + 1;
        }
        kama (nd > e + 1) {
            json_bafa_baiti(b, 46);
            i = e + 1;
            wakati (i < nd) {
                json_bafa_baiti(b, tar[i]);
                i = i + 1;
            }
        }
        rudisha;
    }
    kama (e < 0 && e >= -5) {
        json_bafa_mfuatano(b, "0.");
        i = 0;
        wakati (i < (0 - e) - 1) {
            json_bafa_baiti(b, 48);
            i = i + 1;
        }
        i = 0;
        wakati (i < nd) {
            json_bafa_baiti(b, tar[i]);
            i = i + 1;
        }
        rudisha;
    }
    // Nukuu ya kisayansi: d[.ddd]e[+-]XX
    json_bafa_baiti(b, tar[0]);
    kama (nd > 1) {
        json_bafa_baiti(b, 46);
        i = 1;
        wakati (i < nd) {
            json_bafa_baiti(b, tar[i]);
            i = i + 1;
        }
    }
    json_bafa_baiti(b, 101);
    n32 ae = e;
    kama (e < 0) {
        json_bafa_baiti(b, 45);
        ae = 0 - e;
    } sivyo {
        json_bafa_baiti(b, 43);
    }
    n8 kt[8];
    n32 nk = 0;
    wakati (1 == 1) {
        kt[nk] = 48 + (ae % 10);
        nk = nk + 1;
        ae = ae / 10;
        kama (ae == 0) { vunja; }
    }
    wakati (nk > 0) {
        nk = nk - 1;
        json_bafa_baiti(b, kt[nk]);
    }
}

w0 json_ongeza_mstari_mpya(JsonBafa* b, n32 ndani, n32 kina) {
    json_bafa_baiti(b, 10);
    json_bafa_nafasi(b, ndani * kina);
}

// Andika thamani `v` kwenye `b`. `ndani` = nafasi kwa kila ngazi (0 =
// mstari mmoja), `kina` = ngazi ya sasa. Thamani zilizojengwa kwa
// programu zenye kina > 4096 zinakataliwa (b->kosa) kulinda rafu.
w0 json_andika_thamani(Json* v, JsonBafa* b, n32 ndani, n32 kina) {
    kama (kina > 4096) {
        b->kosa = 1;
        rudisha;
    }
    kama (v->aina == JSON_NULL) {
        json_bafa_mfuatano(b, "null");
        rudisha;
    }
    kama (v->aina == JSON_BOOL) {
        kama (v->kweli != 0) {
            json_bafa_mfuatano(b, "true");
        } sivyo {
            json_bafa_mfuatano(b, "false");
        }
        rudisha;
    }
    kama (v->aina == JSON_NAMBARI) {
        kama (v->maandishi != 0) {
            json_bafa_mfuatano(b, v->maandishi);
        } sivyo {
            json_andika_d64(b, v->nambari);
        }
        rudisha;
    }
    kama (v->aina == JSON_MFUATANO) {
        json_andika_herufi(b, v->maandishi);
        rudisha;
    }
    n32 i = 0;
    kama (v->aina == JSON_ORODHA) {
        kama (v->idadi == 0) {
            json_bafa_mfuatano(b, "[]");
            rudisha;
        }
        json_bafa_baiti(b, 91);
        wakati (i < v->idadi) {
            kama (i > 0) { json_bafa_baiti(b, 44); }
            kama (ndani > 0) { json_ongeza_mstari_mpya(b, ndani, kina + 1); }
            json_andika_thamani(v->vipengele[i], b, ndani, kina + 1);
            i = i + 1;
        }
        kama (ndani > 0) { json_ongeza_mstari_mpya(b, ndani, kina); }
        json_bafa_baiti(b, 93);
        rudisha;
    }
    // JSON_KITU
    kama (v->idadi == 0) {
        json_bafa_mfuatano(b, "{}");
        rudisha;
    }
    json_bafa_baiti(b, 123);
    wakati (i < v->idadi) {
        kama (i > 0) { json_bafa_baiti(b, 44); }
        kama (ndani > 0) { json_ongeza_mstari_mpya(b, ndani, kina + 1); }
        json_andika_herufi(b, v->funguo[i]);
        json_bafa_baiti(b, 58);
        kama (ndani > 0) { json_bafa_baiti(b, 32); }
        json_andika_thamani(v->vipengele[i], b, ndani, kina + 1);
        i = i + 1;
    }
    kama (ndani > 0) { json_ongeza_mstari_mpya(b, ndani, kina); }
    json_bafa_baiti(b, 125);
}

// JSON yenye upangaji: `ndani` nafasi kwa kila ngazi (mf. 2). Inarudisha
// mfuatano unaoishia kwa NUL, au 0 kumbukumbu ikiisha / kina kikizidi.
n8* json_hadi_mfuatano_mzuri(Json* v, n32 ndani) {
    JsonBafa* b = json_bafa_mpya();
    kama (b == 0) { rudisha 0; }
    json_andika_thamani(v, b, ndani, 0);
    kama (b->kosa != 0) { rudisha 0; }
    b->data[b->idadi] = 0;
    rudisha b->data;
}

// JSON ya mstari mmoja (compact).
n8* json_hadi_mfuatano(Json* v) {
    rudisha json_hadi_mfuatano_mzuri(v, 0);
}

// Sahau maandishi asili ya nambari zote (ili ziandikwe upya kutoka
// kwenye thamani ya D64). Inatumika hasa kupima usahihi wa D64.
w0 json_sahau_maandishi_asili(Json* v) {
    kama (v->aina == JSON_NAMBARI) {
        v->maandishi = 0;
        rudisha;
    }
    kama (v->aina == JSON_ORODHA || v->aina == JSON_KITU) {
        n32 i = 0;
        wakati (i < v->idadi) {
            json_sahau_maandishi_asili(v->vipengele[i]);
            i = i + 1;
        }
    }
}

// Ulinganifu wa kina: thamani mbili zinawakilisha JSON ile ile?
// (Vitu ni sawa bila kujali mpangilio wa funguo; nambari zinalinganishwa
// kwa thamani ya D64.) Inarudisha 1/0.
n32 json_sawa(Json* a, Json* b) {
    kama (a->aina != b->aina) { rudisha 0; }
    kama (a->aina == JSON_NULL) { rudisha 1; }
    kama (a->aina == JSON_BOOL) {
        kama (a->kweli == b->kweli) { rudisha 1; }
        rudisha 0;
    }
    kama (a->aina == JSON_NAMBARI) {
        kama (a->nambari == b->nambari) { rudisha 1; }
        rudisha 0;
    }
    kama (a->aina == JSON_MFUATANO) {
        kama (linganisha_mfuatano(a->maandishi, b->maandishi) == 0) { rudisha 1; }
        rudisha 0;
    }
    kama (a->idadi != b->idadi) { rudisha 0; }
    n32 i = 0;
    kama (a->aina == JSON_ORODHA) {
        wakati (i < a->idadi) {
            kama (json_sawa(a->vipengele[i], b->vipengele[i]) == 0) { rudisha 0; }
            i = i + 1;
        }
        rudisha 1;
    }
    wakati (i < a->idadi) {
        Json* mwenzake = json_pata(b, a->funguo[i]);
        kama (mwenzake == 0) { rudisha 0; }
        kama (json_sawa(a->vipengele[i], mwenzake) == 0) { rudisha 0; }
        i = i + 1;
    }
    rudisha 1;
}
